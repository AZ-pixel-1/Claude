# Interactive Brokers Paper Account Credentials
# ──────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your PAPER account credentials below
# 3. NEVER commit the .env file to version control
#
# To get paper account credentials:
#   - Log in to https://www.interactivebrokers.com
#   - Go to Settings > Paper Trading Account
#   - Note your paper trading username (usually starts with 'D' or 'DU')
#   - Set a separate password for the paper account

IBEAM_ACCOUNT=YOUR_PAPER_USERNAME
IBEAM_PASSWORD=YOUR_PAPER_PASSWORD
