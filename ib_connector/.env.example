# Interactive Brokers Account Credentials (READ-ONLY setup)
# ──────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your account credentials below
# 3. NEVER commit the .env file to version control
#
# SAFETY: The nginx proxy blocks ALL trading endpoints.
# Only market data, portfolio reads, and account info are accessible.

IBEAM_ACCOUNT=YOUR_PAPER_USERNAME
IBEAM_PASSWORD=YOUR_PAPER_PASSWORD
